{
  "context-menu": {
    ".tree-view .full-menu .entry:not(.tree-view-special-entry):not(.tree-view-special-root)": [
      { "type": "separator" },
      {
        "label": "Add to Favourite",
        "command": "tree-view-favourite:add",
        "afterGroupContaining": [
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ]
      },
      { "type": "separator" }
    ],
    ".tree-view .multi-select:not(.special-select)": [
      { "type": "separator" },
      {
        "label": "Add to Favourite",
        "command": "tree-view-favourite:add",
        "afterGroupContaining": [
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ]
      },
      { "type": "separator" }
    ],
    ".tree-view .tree-view-special-entry": [
      { "type": "separator" },
      {
        "label": "Remove from Favourite",
        "command": "tree-view-favourite:remove",
        "afterGroupContaining": [
          "diff-view:enable",
          "jupyter-cells:import-notebook",
          "jupyter-view:open-source",
          "graviss:open-source-on-right",
          "markdown-preview:preview-file",
          "image-editor:open-in-new-tab",
          "search-panel:project-show-in-current-directory",
          "open-external:show",
          "tree-view:open-selected-entry-up",
          "native-clip:paste",
          "tree-view:paste",
          "tree-view:remove",
          "tree-view:add-file"
        ]
      },
      { "type": "separator" }
    ]
  }
}
