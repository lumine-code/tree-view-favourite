{
  "name": "tree-view-favourite",
  "author": "lumine-code",
  "description": "Add files and folders to favourite sections in the tree view.",
  "repository": "https://github.com/lumine-code/tree-view-favourite",
  "bugs": {
    "url": "https://github.com/lumine-code/tree-view-favourite/issues"
  },
  "keywords": [
    "favorites",
    "bookmarks",
    "pinned",
    "shortcuts",
    "sidebar"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "configSchema": {
    "defaultGroup": {
      "title": "Default group",
      "description": "The group new favourites are added to. A group with no entries in the current project is hidden, and one with no entries at all is dropped.",
      "type": "string",
      "default": "Favourite"
    }
  },
  "files": [
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "tree-view.roots": {
      "versions": {
        "^1.0.0": "consumeTreeViewRoots"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
