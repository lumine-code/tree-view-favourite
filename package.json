{
  "name": "tree-view-favourites",
  "author": "lumine-code",
  "description": "Add files and folders to favourite sections in the tree view.",
  "repository": "https://github.com/lumine-code/tree-view-favourites",
  "bugs": {
    "url": "https://github.com/lumine-code/tree-view-favourites/issues"
  },
  "keywords": [
    "favorites",
    "bookmarks",
    "pinned",
    "shortcuts",
    "sidebar"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "backgroundTips": [
    "{% if keys['tree-view-favourites:toggle'] %}You can show or hide your favourite files at the top of the tree view with {{ 'tree-view-favourites:toggle' | keystroke }}{% else %}You can pin the files and folders you use most into favourite sections at the top of the tree view.{% endif %}"
  ],
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    },
    "tree-view.roots": {
      "versions": {
        "^1.0.0": "consumeTreeViewRoots"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
